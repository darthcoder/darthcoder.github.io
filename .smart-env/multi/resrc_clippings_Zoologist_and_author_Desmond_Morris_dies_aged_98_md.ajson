
"smart_sources:resrc/clippings/Zoologist and author Desmond Morris dies aged 98.md": {"path":"resrc/clippings/Zoologist and author Desmond Morris dies aged 98.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1bk4bo2","at":1778505719458},"class_name":"SmartSource","last_import":{"mtime":1777171057965,"size":11794,"at":1778505719458,"hash":"1bk4bo2"},"blocks":{"#---frontmatter---":[1,11],"#":[12,53],"##Giving paint brushes to chimps":[54,161],"##Giving paint brushes to chimps#{1}":[56,161],"##A \"personal view\"":[162,190],"##A \"personal view\"#{1}":[164,190]},"outlinks":[{"title":"Sam Woodhouse","target":"Sam Woodhouse","line":5},{"title":"Getty Images A black and white photograph of Desmond Morris, who wears a dark suit. He is holding a rotary phone receiver to his ear, while behind him is a glass display cabinet with a stuffed, small ring-tailed animal within it, posed on a log.","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/c660/live/ec4591a0-3cb7-11f1-8702-439fce5871c8.jpg.webp","line":22,"embedded":true},{"title":"Getty Images Desmond Morris. The scene is of a school trip to London Zoo. An orangutan is holding up a piece of paper over Desmond Morris' head. It is a black and white photo.","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/3f13/live/dbdb66c0-70e7-11ef-bb5b-c361f7cd4381.jpg.webp","line":40,"embedded":true},{"title":"Getty Images Congo the chimp is in a black and white photo of him painting a piece of paper with a paint brush","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/c9d7/live/595a7a00-70e8-11ef-bb5b-c361f7cd4381.jpg.webp","line":72,"embedded":true},{"title":"Getty Images Newspaper article about Congo's paintings. The headline is \"Art World goes wild for chimpanzee's paintings as Warhol work flops\".  There is a photo of both a chimp painting and the artist Andy Warhol and a colour picture of the chimps splashes of paint","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/9c5e/live/629a7cf0-70e8-11ef-bb5b-c361f7cd4381.jpg.webp","line":90,"embedded":true},{"title":"Getty Images Desmond Morris and Congo the chimp (as a baby)","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/93ca/live/b12c9fb0-70e8-11ef-bb5b-c361f7cd4381.jpg.webp","line":116,"embedded":true},{"title":"Getty Images Desmond Morris is looking at a toucan through the wire of a cage.  The toucan is looking at Morris.","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/a1a0/live/b9dfa4e0-70e8-11ef-bb5b-c361f7cd4381.jpg.webp","line":132,"embedded":true},{"title":"Getty Images Desmond Morris painting. It is a surrealist landscape of half moons on pointed legs and a checked floor.","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/187b/live/c0e85570-70e8-11ef-bb5b-c361f7cd4381.jpg.webp","line":148,"embedded":true},{"title":"Desmond Morris at home. This looks like a busy sitting room with Morris sitting on a red couch surrounded by books and his art works.","target":"https://ichef.bbci.co.uk/news/1536/cpsprodpb/7f9a/live/d4699eb0-70e8-11ef-bb5b-c361f7cd4381.jpg.webp","line":174,"embedded":true}],"metadata":{"title":"Zoologist and author Desmond Morris dies aged 98","source":"https://www.bbc.com/news/articles/c51y797v200o","author":["[[Sam Woodhouse]]"],"published":"2026-04-20","created":"2026-04-26","description":"Morris, who was also a surrealist painter and broadcaster, was best known for his 1967 book The Naked Ape.","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:resrc/clippings/Zoologist and author Desmond Morris dies aged 98.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"189e0xu","at":1778505719458},"key":"resrc/clippings/Zoologist and author Desmond Morris dies aged 98.md#---frontmatter---","lines":[1,11],"size":340,"outlinks":[{"title":"Sam Woodhouse","target":"Sam Woodhouse","line":5}],"class_name":"SmartBlock"},
