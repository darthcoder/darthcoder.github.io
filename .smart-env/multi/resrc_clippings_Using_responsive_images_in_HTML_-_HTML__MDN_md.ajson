et":"https://developer.mozilla.org/en-US/docs/Glossary/Device_pixel","line":125},{"title":"`<picture>`","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/picture","line":129},{"title":"not-responsive.html","target":"https://mdn.github.io/learning-area/html/multimedia-and-embedding/responsive-images/not-responsive.html","line":131},{"title":"`<video>` and `<audio>`","target":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Structuring_content/HTML_video_and_audio","line":137},{"title":"`<img>`","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/img","line":137},{"title":"`<picture>`","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/picture","line":137},{"title":"`<source>`","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/source","line":137},{"title":"responsive.html","target":"https://mdn.github.io/learning-area/html/multimedia-and-embedding/responsive-images/responsive.html","line":137},{"title":"Our example site as viewed on a narrow screen with the picture element used to switch the first image to a portrait close up of the detail, making it a lot more useful on a narrow screen","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Guides/Responsive_images/picture-element-narrow.png","line":153,"embedded":true},{"title":"Our example site as viewed on a wide screen - here the first image works OK, as it is big enough to see the detail in the center.","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Guides/Responsive_images/picture-element-wide.png","line":153,"embedded":true},{"title":"`<img>`","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/img","line":159},{"title":"`<picture>`","target":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/picture","line":175},{"title":"vector graphics","target":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/